# BRICKED-UP Frontend Configuration

# Base URL for the AWS API Gateway endpoint (leave empty for mock mode)
VITE_API_BASE_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/prod

# Whether the app should bypass AWS endpoints and use simulated mock responses
# Set to 'false' only when Cognito, S3, RDS, Lambda, and API Gateway are wired
VITE_USE_MOCKS=true
